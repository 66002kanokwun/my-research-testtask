# --- AI provider ---
# provider: deepseek | mock (mock = ไม่เรียก API ใช้ทดสอบ pipeline)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_MAX_TOKENS=8000
DEEPSEEK_API_KEY=sk-sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- SonarQube ---
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=squ_xxxx
# local = ใช้ sonar-scanner ที่ติดตั้งในเครื่อง, docker = ใช้ image sonarsource/sonar-scanner-cli
SONAR_SCANNER_MODE=docker
SONAR_SCANNER_BIN=sonar-scanner
# ใช้ตอน scanner mode=docker (Mac/Windows: http://host.docker.internal:9000)
SONAR_SCANNER_HOST_URL=http://host.docker.internal:9000

# --- paths ---
WORKSPACES_DIR=workspaces
DB_PATH=results.db
